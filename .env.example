# ============================================================================
# Falix Control Panel — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# All values can also be entered through the first-run setup wizard, which
# stores them server-side (secrets are never sent to the browser).
# ============================================================================

# --- Falix ---------------------------------------------------------------
# Base URL of the Falix v2 API (no trailing slash).
FALIX_API_BASE=https://client.falixnodes.net/api/v2
# Falix API key (create one in the Falix dashboard -> API -> Manage keys).
FALIX_API_KEY=
# Numeric Falix server id this panel controls.
FALIX_SERVER_ID=

# --- Minecraft ------------------------------------------------------------
# Public host:port players use to join (used for live query checks).
MINECRAFT_SERVER_HOST=
MINECRAFT_SERVER_PORT=25565

# --- Supabase -------------------------------------------------------------
# New projects: sb_publishable_... / sb_secret_... (Settings -> API keys).
# Older projects: legacy anon / service_role JWTs — both are accepted.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres DATABASE password (Supabase -> Settings -> Database).
# NOT the service-role key. The panel discovers the region automatically.
SUPABASE_DB_PASSWORD=
# Optional: full Postgres connection string (overrides SUPABASE_DB_PASSWORD)
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: Discord webhook for server notifications (also settable in setup)
DISCORD_WEBHOOK_URL=

# --- Optional: direct RCON fallback ---------------------------------------
# Used only if the Falix console API is unavailable for your key scopes.
RCON_PORT=
RCON_PASSWORD=

# --- Panel <-> Minecraft-mod integration ----------------------------------
# Shared secret the Minecraft-side mod must present in X-Integration-Key.
# Generate with: openssl rand -hex 32
INTEGRATION_SECRET_KEY=

# --- Production bootstrap (Netlify / Vercel / Docker) ----------------------
# AUTO_SETUP=true applies migrations and creates the admin account from these
# env vars on first boot - the setup wizard never appears.
AUTO_SETUP=true
PANEL_ADMIN_USERNAME=
PANEL_ADMIN_PASSWORD=
