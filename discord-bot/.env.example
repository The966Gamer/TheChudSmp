# Discord bot token — Developer Portal → your application → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Panel base URL the bot calls (no trailing slash)
#   local panel:  http://localhost:3000
#   netlify:      https://your-site.netlify.app
PANEL_URL=http://localhost:3000

# Shared service key — paste the SAME value in the panel:
#   Discord page → "Discord bot — separate service" → Save service key
# (or set BOT_SERVICE_KEY in the panel's environment)
PANEL_SERVICE_KEY=
