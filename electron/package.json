{
  "name": "falix-panel-desktop",
  "productName": "Falix Control Panel",
  "version": "1.0.0",
  "description": "Desktop app for the Falix Minecraft Control Panel — native window and real OS notifications.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --mac --linux",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "net.falix.panel",
    "productName": "Falix Control Panel",
    "files": ["main.js", "preload.js", "icon.png"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": ["AppImage"]
    },
    "nsis": {
      "oneClick": true
    }
  }
}
